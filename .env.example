# ==========================================
# RoomieSplit Root Configuration Template
# ==========================================

# Application
PROJECT_NAME="RoomieSplit API"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"

# Security & JWT Authentication
SECRET_KEY="replace_with_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
POSTGRES_USER="parat"
POSTGRES_PASSWORD=""
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="roomie_db"

# Complete Database URL
DATABASE_URL="postgresql://parat@localhost:5433/roomie_db"

# Server Host & Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# CORS Origins
CORS_ORIGINS="*"

# Flutter Frontend
FRONTEND_API_BASE_URL="http://localhost:8000/api"
